<div class="contextual">
	<a href="#"
		 class="icon-only icon-checked bf-mark-selected-read is-disabled"
		 aria-disabled="true"
   title="<%= l(:'bf_readup.blocks.updates.bulk_mark_read_title') %>"></a>

  <a href="#"
     class="icon-only icon-reload bf-readup-updates-sync"
     title="<%= l(:'bf_readup.blocks.updates.sync_title') %>"></a>

  <a href="#"
     class="icon-only icon-settings bf-readup-updates-open-settings"
     title="<%= l(:'bf_readup.blocks.updates.settings_title') %>"></a>

  <span id="bf-readup-updates-sync-status"
        class="bf-readup-sync-status"
        style="margin-left:8px; font-size:11px; color:#777; white-space:nowrap;"
        title="">
    <!-- filled by JS -->
  </span>
</div>

<h3 class="bf-readup-updates-header">
  <%= l(:'bf_readup.blocks.updates.header') %>
  (<span id="bf-readup-updates-total-count">0</span>)
</h3>

<!-- SETTINGS PANEL -->
<div id="bf-readup-updates-settings" style="display:none;">
  <%= render "settings/bf_readup_updates_settings" %>
</div>

<p id="bf-readup-updates-empty"
   class="nodata"
   style="display:none; margin:1em 0;">
	<%= l(:'bf_readup.blocks.updates.empty') %>
</p>

<!-- TABELL -->
<div class="autoscroll bf-readup-updates-table-wrapper" id="bf-readup-updates-table">
  <table class="list issues bf-readup-updates-table">
    <thead id="bf-readup-updates-thead"></thead>
    <tbody id="bf-readup-updates-tbody"></tbody>
  </table>
</div>

<!-- FOOTER -->
<div class="bf-readup-updates-footer">

  <!-- MAXIMERA / MINIMERA -->
	<button id="bf-readup-updates-expand" class="bf-readup-updates-expand">
		<span class="icon icon-zoom-in"></span>
 	<span class="label"><%= l(:'bf_readup.blocks.updates.show_more') %></span>
	</button>

  <!-- PAGINATION (Redmine-style, renderas av JS) -->
  <div id="bf-readup-updates-pagination"></div>

</div>

<%= stylesheet_link_tag 'bf_readup_updates', plugin: 'bf_readup' %>
<%= javascript_include_tag 'bf_readup_shared', plugin: 'bf_readup' %>
<%= javascript_include_tag 'bf_readup_updates', plugin: 'bf_readup' %>
