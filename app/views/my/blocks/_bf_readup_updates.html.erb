<div class="contextual">
	<a href="#"
		 class="icon-only icon-checked bf-mark-selected-read is-disabled"
		 aria-disabled="true"
		 title="<%= l(:'bf_readup.common.mark_selected_require_selection') %>"></a>

  <a href="#"
     class="icon-only icon-reload bf-readup-updates-sync"
     title="<%= l(:'bf_readup.blocks.updates.sync_title') %>"></a>

  <a href="#"
     class="icon-only icon-settings bf-readup-updates-open-settings"
     title="<%= l(:'bf_readup.blocks.updates.settings_title') %>"></a>
</div>

<h3 class="bf-readup-updates-header">
	<%= l(:'bf_readup.blocks.updates.header') %>
  (<span id="bf-readup-updates-total-count">0</span>)
</h3>

<!-- SETTINGS PANEL -->
<div id="bf-readup-updates-settings" style="display:none;">
  <%= render "settings/bf_readup_updates_settings" %>
</div>

<p id="bf-readup-updates-empty"
   class="nodata"
   style="display:none; margin:1em 0;">
	<%= l(:'bf_readup.blocks.updates.empty') %>
</p>

<!-- TABELL -->
<div class="autoscroll bf-readup-updates-table-wrapper" id="bf-readup-updates-table">
  <table class="list issues bf-readup-updates-table">
    <thead id="bf-readup-updates-thead"></thead>
    <tbody id="bf-readup-updates-tbody"></tbody>
  </table>
</div>

<!-- FOOTER -->
<div class="bf-readup-updates-footer">

  <!-- MAXIMERA / MINIMERA -->
	<button id="bf-readup-updates-expand" class="bf-readup-updates-expand">
		<span class="icon icon-zoom-in"></span>
		<span class="label">
			<%= l(:'bf_readup.common.show_more') %>
		</span>
	</button>

  <!-- PAGINATION (Redmine-style, renderas av JS) -->
  <div id="bf-readup-updates-pagination"></div>

</div>

<%= stylesheet_link_tag 'bf_readup_updates', plugin: 'bf_readup' %>

<script>
  window.BF = window.BF || {};
  BF.locales = BF.locales || {};
  Object.assign(BF.locales, {
    show_more: "<%= j l(:'bf_readup.common.show_more') %>",
    show_less: "<%= j l(:'bf_readup.common.show_less') %>",
    next_label: "<%= j l(:'bf_readup.common.next_label') %>",
    previous_label: "<%= j l(:'bf_readup.common.previous_label') %>",
    mark_selected_require_selection: "<%= j l(:'bf_readup.common.mark_selected_require_selection') %>",
    mark_selected_read: "<%= j l(:'bf_readup.common.mark_selected_read') %>",
    mark_as_read: "<%= j l(:'bf_readup.common.mark_as_read') %>",
    cannot_mark_as_read: "<%= j l(:'bf_readup.common.cannot_mark_as_read') %>",
    just_now: "<%= j l(:'bf_readup.common.just_now') %>",
    sync_title: "<%= j l(:'bf_readup.blocks.updates.sync_title') %>",
    locked: "<%= j l(:'bf_readup.common.locked', default: '(låst)') %>",
    units: {
      minute: "<%= j l(:'bf_readup.units.minute') %>",
      hour: "<%= j l(:'bf_readup.units.hour') %>",
      day: "<%= j l(:'bf_readup.units.day') %>"
    },
    columns: {
      issue: "<%= j l(:'bf_readup.columns.issue') %>",
      project: "<%= j l(:'bf_readup.columns.project') %>",
      status: "<%= j l(:'bf_readup.columns.status') %>",
      last_updated: "<%= j l(:'bf_readup.columns.last_updated') %>",
      last_viewed: "<%= j l(:'bf_readup.columns.last_viewed') %>",
      tracker: "<%= j l(:'bf_readup.columns.tracker') %>",
      subject: "<%= j l(:'bf_readup.columns.subject') %>",
      read_ago: "<%= j l(:'bf_readup.columns.read_ago') %>",
      activity_ago: "<%= j l(:'bf_readup.columns.activity_ago') %>",
      new_count: "<%= j l(:'bf_readup.columns.new_count') %>",
      type: "<%= j l(:'bf_readup.columns.type') %>",
      time_spent: "<%= j l(:'bf_readup.columns.time_spent') %>"
    }
  });
</script>

<%= javascript_include_tag 'bf_readup_updates', plugin: 'bf_readup' %>
