<!-- app/views/bf_readup/_bf_readup_most_mypage.html.erb -->

<div class="contextual">
  <a href="#"
     class="icon-only icon-reload bf-readup-most-sync"
     title="<%= l(:'bf_readup.common.sync_title') %>"></a>
</div>

<div class="bf-readup-most">

	<h3 class="bf-readup-most-header">
		<%= l(:'bf_readup.blocks.most.header') %> (<span id="bf-readup-most-total-count">0</span>)
	</h3>

	<p id="bf-readup-most-empty"
		 class="nodata"
		 style="display:none; margin:1em 0;">
		<%= l(:'bf_readup.common.empty') %>
	</p>

	<table id="bf-readup-most-table" class="list issues">
		<thead id="bf-readup-most-thead">
			<!-- byggs av JS -->
		</thead>

		<tbody id="bf-readup-most-tbody">
			<!-- rader injiceras via JS -->
		</tbody>
	</table>

	<!-- FOOTER -->
	<div class="bf-readup-most-footer">
		<div class="bf-readup-most-footer-inner">
			<button id="bf-readup-most-expand" class="bf-readup-most-expand">
				<span class="icon icon-zoom-in"></span>
				<span class="label"><%= l(:'bf_readup.common.show_more') %></span>
			</button>
			<div id="bf-readup-most-pagination"></div>
		</div>
	</div>

</div>

<%= stylesheet_link_tag  'bf_readup_most', plugin: 'bf_readup' %>

<script>
  window.BF = window.BF || {};
  BF.locales = BF.locales || {};
  Object.assign(BF.locales, {
    show_more: "<%= j l(:'bf_readup.common.show_more') %>",
    show_less: "<%= j l(:'bf_readup.common.show_less') %>",
    empty: "<%= j l(:'bf_readup.common.empty') %>",
    sync_title: "<%= j l(:'bf_readup.common.sync_title') %>",
    just_now: "<%= j l(:'bf_readup.common.just_now') %>",
    units: {
      minute: "<%= j l(:'bf_readup.units.minute') %>",
      hour: "<%= j l(:'bf_readup.units.hour') %>",
      day: "<%= j l(:'bf_readup.units.day') %>"
    },
    columns: {
      issue: "<%= j l(:'bf_readup.columns.issue') %>",
      project: "<%= j l(:'bf_readup.columns.project') %>",
      tracker: "<%= j l(:'bf_readup.columns.tracker') %>",
      subject: "<%= j l(:'bf_readup.columns.subject') %>",
      new_count: "<%= j l(:'bf_readup.columns.new_count') %>"
    }
  });
</script>

<%= javascript_include_tag 'bf_readup_most', plugin: 'bf_readup' %>
