<!-- app/views/bf_readup/_bf_readup_recent.html.erb -->

<div class="contextual">
  <a href="#"
     class="icon-only icon-reload bf-readup-recent-sync"
     title="Uppdatera"></a>
</div>

<div class="bf-readup-recent">

  <h3 class="bf-readup-recent-header">
    Senast besökta ärenden (<span id="bf-readup-recent-total-count">0</span>)
  </h3>

  <p id="bf-readup-recent-empty"
     class="nodata"
     style="display:none; margin:1em 0;">
    Inga ärenden att visa.
  </p>

  <table id="bf-readup-recent-table" class="list issues">
    <thead id="bf-readup-recent-thead"></thead>
    <tbody id="bf-readup-recent-tbody"></tbody>
  </table>

  <div class="bf-readup-recent-footer">
    <div class="bf-readup-recent-footer-inner">
      <button id="bf-readup-recent-expand" class="bf-readup-recent-expand">
        <span class="icon icon-zoom-in"></span>
        <span class="label">Visa fler</span>
      </button>
      <div id="bf-readup-recent-pagination"></div>
    </div>
  </div>

</div>

<%= javascript_include_tag 'bf_readup_recent', plugin: 'bf_readup' %>
<%= stylesheet_link_tag  'bf_readup_recent', plugin: 'bf_readup' %>
