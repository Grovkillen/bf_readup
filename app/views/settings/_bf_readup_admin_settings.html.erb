<%
  prio_levels = JSON.parse(@settings['prio_levels'] || '[]') rescue []
  custom_field_matchers = JSON.parse(@settings['custom_field_matchers'] || '[]') rescue []
%>
<div class="bf-readup-admin">

  <h2><%= l(:'bf_readup.admin.title') %></h2>

  <!-- ====================== -->
  <!--  General -->
  <!-- ====================== -->
  <fieldset class="box">
    <legend><%= l(:'bf_readup.admin.general') %></legend>

    <p>
      <label><%= l(:'bf_readup.admin.heartbeat_interval_seconds') %></label>
      <input type="number" name="settings[heartbeat_interval_seconds]"
        value="<%= @settings['heartbeat_interval_seconds'] %>" min="1" size="6">
      <br>
      <small class="info"><%= l(:'bf_readup.admin.heartbeat_hint') %></small>
    </p>

    <p>
      <label><%= l(:'bf_readup.admin.lookback_days') %></label>
      <input type="number" name="settings[lookback_days]"
        value="<%= @settings['lookback_days'] %>" min="1" size="6">
      <br>
      <small class="info"><%= l(:'bf_readup.admin.lookback_hint') %></small>
    </p>

    <p>
      <label><%= l(:'bf_readup.admin.mark_as_read_max_rank') %></label>
      <input
        type="number"
        name="settings[mark_as_read_max_rank]"
        value="<%= @settings['mark_as_read_max_rank'] %>"
        min="0"
        size="6">
      <em><%= l(:'bf_readup.admin.mark_as_read_max_rank_hint') %></em>
    </p>

    <p>
      <label>
        <input type="checkbox" name="settings[expose_user_debug_option]" value="1" <%= @settings['expose_user_debug_option'].to_s == '1' ? 'checked' : '' %> >
        <%= l(:'bf_readup.admin.expose_user_debug_option') %>
      </label>
      <br>
      <small class="info"><%= l(:'bf_readup.admin.expose_user_debug_option_hint') %></small>
    </p>
  </fieldset>

  <!-- ====================== -->
  <!--  Priority rules -->
  <!-- ====================== -->
  <fieldset class="box">
    <legend><%= l(:'bf_readup.admin.priority_rules') %></legend>

    <table class="list" id="prio-rules-table">
      <thead>
        <tr>
          <th title="<%= l(:'bf_readup.admin.table.rank_hint') %>"><%= l(:'bf_readup.admin.table.rank') %></th>
          <th><%= l(:'bf_readup.admin.table.icon') %></th>
          <th><%= l(:'bf_readup.admin.table.label') %></th>
          <th><%= l(:'bf_readup.admin.table.key') %></th>
          <th><%= l(:'bf_readup.admin.table.method') %></th>
          <th><%= l(:'bf_readup.admin.table.active') %></th>
          <th><%= l(:'bf_readup.admin.table.delete') %></th>
        </tr>
      </thead>

      <tbody>
        <% prio_levels.each_with_index do |rule, idx| %>
          <tr data-index="<%= idx %>" draggable="true">
            <td class="pr-rank-display"><%= rule['rank'] || (idx + 1) %></td>
            <td><input type="text"   class="pr-icon"      value="<%= rule['icon'] %>" size="3"></td>
            <td><input type="text"   class="pr-label"     value="<%= rule['label'] %>"></td>
            <td>
              <select class="pr-key"></select>
              <input type="text" class="pr-key-custom" value="" style="display:none;" placeholder="custom_key">
              <input type="hidden" class="pr-key-initial" value="<%= rule['key'] %>">
            </td>
            <td>
              <select class="pr-method"></select>
              <input type="hidden" class="pr-method-initial" value="<%= rule['method'] %>">
            </td>
            <td><input type="checkbox" class="pr-active"  <%= rule['active'] == "on" ? "checked" : "" %> ></td>
            <td><button type="button" class="icon icon-del pr-del"></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <button type="button" class="icon icon-add" id="add-prio-rule"><%= l(:'bf_readup.admin.add_priority_rule') %></button>
    <button type="button" class="icon icon-reload" id="load-default-prio"><%= l(:'bf_readup.admin.load_default_priority_rules') %></button>
    <br>
    <small class="info"><%= l(:'bf_readup.admin.drag_drop_hint') %></small>

    <input type="hidden" name="settings[prio_levels]" id="prio-rules-json">
  </fieldset>

  <!-- ====================== -->
  <!--  CF rules -->
  <!-- ====================== -->
  <fieldset class="box">
    <legend><%= l(:'bf_readup.admin.cf_rules') %></legend>

    <table class="list" id="cf-rules-table">
      <thead>
        <tr>
          <th><%= l(:'bf_readup.admin.table.cf_id') %></th>
          <th><%= l(:'bf_readup.admin.table.pattern') %></th>
          <th><%= l(:'bf_readup.admin.table.priority_key') %></th>
          <th><%= l(:'bf_readup.admin.table.delete') %></th>
        </tr>
      </thead>

      <tbody>
        <% custom_field_matchers.each_with_index do |rule, idx| %>
          <tr data-index="<%= idx %>">
            <td><input type="number" class="cf-id"         value="<%= rule['id'] %>"></td>
            <td><input type="text"   class="cf-match"      value="<%= rule['match'] %>"></td>
            <td><input type="text"   class="cf-priority"   value="<%= rule['priority_key'] %>"></td>
            <td><button type="button" class="icon icon-del cf-del"></button></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <button type="button" class="icon icon-add" id="add-cf-rule"><%= l(:'bf_readup.admin.add_cf_rule') %></button>

    <input type="hidden" name="settings[custom_field_matchers]" id="cf-rules-json">
  </fieldset>

</div>

<%= javascript_include_tag 'bf_readup_admin', plugin: 'bf_readup' %>
<%= stylesheet_link_tag 'bf_readup_admin', plugin: 'bf_readup' %>
