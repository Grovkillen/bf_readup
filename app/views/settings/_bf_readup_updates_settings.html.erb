<!-- A) PRIORITETSFILTER -->
<fieldset class="bf-settings-group">
	<legend><%= l(:'bf_readup.updates_settings.legend_priorities') %></legend>

	<div id="bf-readup-prio-list">
		<!-- byggs dynamiskt -->
	</div>

	<small class="bf-settings-hint">
		<%= l(:'bf_readup.updates_settings.policy_hint') %>
	</small>
</fieldset>

<!-- B) ÖVRIGA FILTER -->
<fieldset class="bf-settings-group">
	<label>
		<input type="checkbox" id="bf-hide-closed">
		<%= l(:'bf_readup.updates_settings.hide_closed') %>
	</label>
</fieldset>

<hr>

<!-- C) DEBUG (lokalt) -->
<% if Setting.plugin_bf_readup && Setting.plugin_bf_readup['expose_user_debug_option'].to_s == '1' %>
  <label class="bf-debug-toggle">
      <input type="checkbox" id="bf-readup-debug-checkbox">
      <%= l(:'bf_readup.updates_settings.debug_enable') %>
  </label>
  <br>
  <small style="color:#777;">
      <%= l(:'bf_readup.updates_settings.debug_hint') %>
  </small>
<% end %>

