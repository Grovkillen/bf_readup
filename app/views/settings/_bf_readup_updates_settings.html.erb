<!-- A) PRIORITETSFILTER -->
<fieldset class="bf-settings-group">
	<legend>Visa prioriteringar</legend>

	<div id="bf-readup-prio-list">
		<!-- byggs dynamiskt -->
	</div>

	<small class="bf-settings-hint">
		Vissa prioriteringar kan inte döljas enligt systempolicy.
	</small>
</fieldset>

<!-- B) ÖVRIGA FILTER -->
<fieldset class="bf-settings-group">
	<label>
		<input type="checkbox" id="bf-hide-closed">
		Göm stängda ärenden
	</label>
</fieldset>

<hr>

<!-- C) DEBUG (lokalt) -->
<label class="bf-debug-toggle">
	<input type="checkbox" id="bf-readup-debug-checkbox">
	Aktivera debug-läge (lokalt)
</label>
<br>
<small style="color:#777;">
	Debug-läge visar rådata, filterresultat och skickar
	<code>debug: true</code> till backend.
	Endast synligt för dig via LocalStorage.
</small>

